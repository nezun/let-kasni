NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://letkasni.rs
NEXT_PUBLIC_SUPPORT_EMAIL=kontakt@letkasni.rs
NEXT_PUBLIC_SUPPORT_PHONE=+381637003779

# Public company identity is maintained in src/lib/site-operator.ts.

# Minimal admin access. If Supabase Auth is configured, these should match
# a real admin user in Supabase Auth. If Supabase is not configured yet, these
# values are used for the local fallback gate.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional provider wiring for the flight lookup adapter.
FLIGHT_PROVIDER_MODE=
FLIGHT_LOOKUP_TIMEOUT_MS=
FLIGHT_PROVIDER_DAILY_LIMIT=50
AVIATION_EDGE_API_KEY=
AERODATABOX_API_KEY=
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com

# Optional analytics wiring.
NEXT_PUBLIC_ANALYTICS_MODE=
ANALYTICS_MODE=
PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Meta Ads tracking. Keep the access token server-side only.
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
# Use the current Graph API version supported by the Pixel access token.
META_GRAPH_API_VERSION=v23.0
# Set only while validating events in Meta Events Manager Test Events.
META_TEST_EVENT_CODE=

# Optional admin email notifications via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ADMIN_TO_EMAIL=

# Optional email-offer subscriptions. Keep both flags off until the additive
# migration, transfer review and rollback plan are verified in production.
NEXT_PUBLIC_MARKETING_SUBSCRIPTIONS_ENABLED=0
MARKETING_SUBSCRIPTIONS_ENABLED=0
MARKETING_CONSENT_TOKEN_SECRET=
# Set only after the documented Vercel/Resend/Google transfer review is accepted.
MARKETING_TRANSFER_REVIEW_VERSION=

# Optional Google Search Console automation.
# Add the service account email as an owner/user for this property in Search Console.
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:letkasni.rs
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PRIVATE_KEY_BASE64=
GOOGLE_OAUTH_CLIENT_CREDENTIALS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Pregled predmeta (/pregled/<ključ>) — read-only pregled za tim i advokate.
# Ključevi po ulozi, najmanje 24 znaka: "tim:<ključ>,advokati:<ključ>".
PREGLED_KLJUCEVI=
# Indeks predmeta na Google Drive-u (Letkasni.rs / LetKasni — sistem / indeks.json).
PREGLED_INDEKS_DRIVE_FILE_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Samo za lokalni razvoj: putanja do indeks.json na disku (ignoriše se u produkciji).
PREGLED_INDEKS_PATH=

# LetKasni pipeline (scripts/sistem u pipeline folderu): Drive folder sistema
# („LetKasni — sistem“ u produkciji, „LetKasni — test“ na preview-u). Forma predaje nove claim-ove
# u <folder>/prijem, portal dokumenata piše u <folder>/uploads/<REF>, signNow webhook u <folder>/dogadjaji.
# Prazno = isključeno (forma radi kao do sada).
PIPELINE_DRIVE_FOLDER_ID=
# Tajna za linkove /dokumenta/<token> (najmanje 32 znaka; ista vrednost kao u pipeline scripts/.env).
DOKUMENTA_TAJNA=
# Ključ u callback URL-u signNow webhook-a: /api/potpis/signnow?kljuc=<ključ> (najmanje 24 znaka).
SIGNNOW_WEBHOOK_KLJUC=
